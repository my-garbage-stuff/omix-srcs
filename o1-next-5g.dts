/dts-v1/;

/ {
	model-part-name = "MT6835V/TTZB";
	#address-cells = <0x02>;
	model = "MT6835";
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	compatible = "mediatek,MT6835";
	model-external-name = "MT6835V/TTZB";
	name = [00];

	cache-parity {
		arm_dsu_ecc_hwirq = <0x20>;
		interrupts = <0x00 0x01 0x04 0x00 0x00 0x02 0x04 0x00 0x00 0x03 0x04 0x00 0x00 0x04 0x04 0x00 0x00 0x05 0x04 0x00 0x00 0x06 0x04 0x00 0x00 0x07 0x04 0x00 0x00 0x08 0x04 0x00 0x00 0x00 0x04 0x00>;
		ecc-irq-support = <0x01>;
		compatible = "mediatek,mt6873-cache-parity";
		name = "cache-parity";
	};

	therm_intf: therm_intf@114000 {
		reg-names = "therm_sram";
		compatible = "mediatek,therm_intf";
		reg = <0x00 0x114000 0x00 0x400>;
		phandle = <0xd5>;
		name = "therm_intf";
	};

	nebula {
		tee-name = "nebula";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		tee-id = <0x01>;
		compatible = "android,nebula-smc-v1";
		ranges;
		name = "nebula";

		nebula-irq {
			compatible = "android,nebula-irq-v1";
			name = "nebula-irq";
			ppi-interrupt-parent = <0x01>;
		};

		nebula-virtio {
			compatible = "android,nebula-virtio-v1";
			name = "nebula-virtio";
		};

		nebula-gz-log {
			compatible = "android,nebula-gz-log-v1";
			name = "nebula-gz-log";
		};
	};

	debug-kinfo {
		memory-region = <0x256>;
		compatible = "google,debug-kinfo";
		name = "debug-kinfo";
	};

	tinysys_mbox: tinysys_mbox@1c351000 {
		shmem = <0x1c 0x1d>;
		interrupts = <0x00 0x1fd 0x04 0x00 0x00 0x1fe 0x04 0x00>;
		#mbox-cells = <0x01>;
		compatible = "mediatek,tinysys_mbox";
		reg = <0x00 0x1c351000 0x00 0x1000 0x00 0x1c361000 0x00 0x1000>;
		phandle = <0x1b>;
		name = "tinysys_mbox";
	};

	smi_pd_cam_main: smi_pd_cam_main {
		power-domains = <0x31 0x08>;
		mediatek,suspend-check-dev = <0xa5>;
		compatible = "mediatek,smi-pd";
		suspend-check;
		phandle = <0x183>;
		mediatek,suspend-check-port = <0xc0>;
		name = "smi_pd_cam_main";
	};

	afe_clk: syscon@11050000 {
		#clock-cells = <0x01>;
		compatible = "mediatek,mt6835-afe", "syscon";
		reg = <0x00 0x11050000 0x00 0x1000>;
		phandle = <0x87>;
		name = "syscon";
	};

	pe: pe {
		ta_ac_7v_input_current = <0x30d400>;
		vbat_threshold = <0x1036>;
		pe_ichg_level_threshold = <0xf4240>;
		compatible = "mediatek,charger,pe";
		ta_ac_9v_input_current = <0x1e8480>;
		pe_charger_current = "", "=\t";
		phandle = <0x16b>;
		ta_stop_battery_soc = <0x5f>;
		ta_ac_12v_input_current = <0x30d400>;
		ta_9v_support;
		min_charger_voltage = <0x4630c0>;
		name = "pe";
		ta_start_battery_soc = <0x00>;
		gauge = <0x21e>;
	};

	smi_larb13: smi_larb13@1a001000 {
		power-domains = <0x31 0x08>;
		clock-names = "apb", "smi";
		clocks = <0x39 0x00 0x39 0x00>;
		mediatek,larb-id = <0x0d>;
		compatible = "mediatek,smi_larb13", "mediatek,mt6835-smi-larb", "mediatek,smi-larb";
		reg = <0x00 0x1a001000 0x00 0x1000>;
		phandle = <0x58>;
		mediatek,smi = <0xa8>;
		name = "smi_larb13";
	};

	swpm: swpm {
		pmu-boundary-num = <0x00>;
		compatible = "mediatek,mtk-swpm";
		pmu-dsu-support = <0x00>;
		pmu-dsu-type = <0x09>;
		phandle = <0x19a>;
		name = "swpm";
	};

	touch: touch {
		interrupts = <0x04 0x02>;
		interrupt-parent = <0x20>;
		compatible = "mediatek,touch";
		status = "okay";
		phandle = <0xe5>;
		name = "touch";
	};

	cpuhvfs: cpuhvfs@114400 {
		nvmem-cells = <0x16>;
		tbl-off = <0x04 0x4c 0x94>;
		apmixedsys = <0x14>;
		reg-names = "USRAM", "CSRAM", "ESRAM";
		clk-div-base = <0x15>;
		cslog-range = <0x3d0 0xfa0>;
		pll-con = <0x20c 0x21c 0x23c>;
		clk-div = <0xa2a0 0xa2a4 0xa2e0>;
		compatible = "mediatek,cpufreq-hybrid";
		nvmem-cell-names = "lkginfo";
		reg = <0x00 0x114400 0x00 0xc00 0x00 0x11bc00 0x00 0x1400 0x00 0x112800 0x00 0x1800 0x00 0x114f40 0x00 0xc0>;
		phandle = <0xc3>;
		proc1-supply = <0x1bb>;
		mcucfg-ver = <0x00>;
		proc2-supply = <0x1bc>;
		name = "cpuhvfs";
		proc3-supply = <0x1bb>;
	};

	mcusys_config_reg_clk: syscon@c53c000 {
		#clock-cells = <0x01>;
		compatible = "mediatek,mt6835-mcusys_config_reg", "syscon";
		reg = <0x00 0xc53c000 0x00 0x1000>;
		phandle = <0x180>;
		name = "syscon";
	};

	gps: gps@18c00000 {
		pinctrl-4 = <0x20d>;
		pinctrl-names = "default", "gps_l1_lna_disable", "gps_l1_lna_dsp_ctrl", "gps_l1_lna_enable", "gps_l5_lna_disable", "gps_l5_lna_dsp_ctrl", "gps_l5_lna_enable";
		emi-size = <0xfffff>;
		pinctrl-2 = <0x20b>;
		gnss-pmic = <0x18e9>;
		emi-domain-ap = <0x00>;
		pinctrl-0 = <0x209>;
		pinctrl-5 = <0x20e>;
		emi-region = <0x1d>;
		emi-offset = <0x650000>;
		pinctrl-3 = <0x20c>;
		compatible = "mediatek,gps";
		pinctrl-1 = <0x20a>;
		status = "okay";
		phandle = <0x194>;
		emi-domain-conn = <0x02>;
		pinctrl-6 = <0x20f>;
		name = "gps";
	};

	smi_infra_disp_subcommon1: smi_infra_disp_subcomm1@1e808000 {
		power-domains = <0x31 0x0c>;
		clock-names = "apb", "smi", "gals0", "gals1";
		clocks = <0x4b 0x00 0x4b 0x01 0x4b 0x01 0x4b 0x02>;
		compatible = "mediatek,mt6835-smi-common", "mediatek,smi-common", "syscon", "mediatek,smi-sub-common";
		mediatek,common-id = <0x02>;
		reg = <0x00 0x1e808000 0x00 0x1000>;
		phandle = <0xa3>;
		name = "smi_infra_disp_subcomm1";
	};

	imp_iic_wrap_en_clk: syscon@11ed4000 {
		#clock-cells = <0x01>;
		compatible = "mediatek,mt6835-imp_iic_wrap_en", "syscon";
		reg = <0x00 0x11ed4000 0x00 0x1000>;
		phandle = <0x3d>;
		name = "syscon";
	};

	disp-sec {
		sw-sync-token-tzmp-disp-set = <0x28e>;
		sw-sync-token-tzmp-disp-wait = <0x28d>;
		compatible = "mediatek,disp-sec";
		mboxes = <0xa1 0x08 0xffffffff 0x04>;
		name = "disp-sec";
	};

	sspm: sspm@1c340000 {
		reg-names = "sspm_base", "cfgreg", "mbox_share";
		interrupts = <0x00 0x1fc 0x04 0x00>;
		sspm_res_ram_start = <0x9f960000>;
		compatible = "mediatek,sspm";
		interrupt-names = "ipc";
		reg = <0x00 0x1c300000 0x00 0x30000 0x00 0x1c340000 0x00 0x10000 0x00 0x1c380000 0x00 0x80>;
		phandle = <0xe9>;
		sspm_res_ram_size = <0x110000>;
		name = "sspm";
	};

	smi_mdp_subcommon1: smi_mdp_sub_comm1@1e80a000 {
		power-domains = <0x31 0x0c>;
		clock-names = "apb", "smi", "gals0", "gals1";
		clocks = <0x4b 0x00 0x4b 0x01 0x4b 0x01 0x4b 0x02>;
		mediatek,dump-with-comm = <0x00>;
		compatible = "mediatek,mt6835-smi-common", "mediatek,smi-common", "syscon", "mediatek,smi-sub-common";
		mediatek,common-id = <0x04>;
		reg = <0x00 0x1e80a000 0x00 0x1000>;
		phandle = <0xa6>;
		mediatek,smi = <0xa5>;
		name = "smi_mdp_sub_comm1";
	};

	hwrng: hwrng {
		quality = [03 84];
		methods = "smc";
		method-fid = [02 6a];
		compatible = "arm,sec-rng";
		phandle = <0x174>;
		name = "hwrng";
	};

	gpu_qos: gpu-qos {
		qos-mode = <0x00>;
		qos-sysram-support = <0x00>;
		qos-value = <0x00>;
		compatible = "mediatek,gpu_qos";
		phandle = <0x1a3>;
		name = "gpu-qos";
	};

	infracfg_ao_clk: syscon@10001000 {
		#clock-cells = <0x01>;
		compatible = "mediatek,mt6835-infracfg_ao", "syscon";
		reg = <0x00 0x10001000 0x00 0x1000>;
		phandle = <0x48>;
		name = "syscon";
	};

	smi_larb7: smi_larb7@17010000 {
		power-domains = <0x31 0x07>;
		clock-names = "apb", "smi";
		clocks = <0x65 0x00 0x65 0x01>;
		mediatek,larb-id = <0x07>;
		compatible = "mediatek,smi_larb7", "mediatek,mt6835-smi-larb", "mediatek,smi-larb";
		reg = <0x00 0x17010000 0x00 0x1000>;
		phandle = <0x56>;
		mediatek,smi = <0xa5>;
		name = "smi_larb7";
	};

	charger_cooler: charger-cooler {
		compatible = "mediatek,mt6375-charger-cooler";
		phandle = <0xd3>;
		name = "charger-cooler";
		#cooling-cells = <0x02>;
	};

	lk_charger: lk_charger {
		temp_t1_threshold = <0x00>;
		non_std_ac_charger_current = <0x7a120>;
		enable_anime;
		ac_charger_current = <0x1e8480>;
		temp_t4_threshold = <0x32>;
		charging_host_charger_current = <0x16e360>;
		max_charger_voltage = <0xa037a0>;
		fast_charge_voltage = <0x2dc6c0>;
		enable_pd20_reset;
		ta_ac_charger_current = <0x2dc6c0>;
		compatible = "mediatek,lk_charger";
		enable_check_vsys;
		phandle = <0x16a>;
		ac_charger_input_current = <0x1e8480>;
		usb_charger_current = <0x7a120>;
		pd_charger_current = <0x7a120>;
		temp_t3_threshold = <0x2d>;
		power_path_support;
		name = "lk_charger";
	};

	charger: charger {
		temp_t3_thres_minus_x_degree = <0x27>;
		battery_cv = <0x43e6d0>;
		temp_t2_thres = <0x0a>;
		jeita_temp_t0_to_t1_cv = <0x3da540>;
		charger = <0x1ab>;
		min_charger_voltage_1 = <0x432380>;
		jeita_temp_above_t4_cv = <0x40b280>;
		ac_charger_current = <0x3dcc50>;
		charger_configuration = <0x00>;
		max_dmivr_charger_current = <0x1b7740>;
		algorithm_name = "Basic";
		temp_t2_thres_plus_x_degree = <0x10>;
		min_charge_temp = <0x00>;
		charging_host_charger_current = <0x16e360>;
		max_charger_voltage = <0x632ea0>;
		temp_t3_thres = <0x2d>;
		max_charge_temp = <0x37>;
		cs,chrg-thermal-zones = <0x00 0x00 0xbea 0x24 0x22 0x708 0x26 0x24 0x6a4 0x2b 0x29 0x640 0x2d 0x2b 0x3e8>;
		cs,chrg-temp-zones-num = <0x06>;
		temp_t0_thres = <0x00>;
		enable_fast_charging_indicator;
		min_charger_voltage_2 = <0x401640>;
		temp_t1_thres_plus_x_degree = <0x06>;
		compatible = "mediatek,charger";
		temp_t4_thres = <0x32>;
		max_charge_temp_minus_x_degree = <0x32>;
		bootmode = <0x42>;
		enable_min_charge_temp;
		jeita_temp_t3_to_t4_cv = <0x40b280>;
		enable_dynamic_mivr;
		fast_charging_indicator = <0x07>;
		phandle = <0x170>;
		ac_charger_input_current = <0x2dc6c0>;
		temp_neg_10_thres = <0x00>;
		temp_t1_thres = <0x00>;
		cs,chrg-temp-zones = <0x00 0x1162 0x00 0x00 0x00 0x00 0x00 0x05 0x1162 0x1f4 0x00 0x00 0x00 0x00 0x0a 0x1162 0x5dc 0x00 0x00 0x00 0x00 0x0f 0x1162 0xdac 0x00 0x00 0x00 0x00 0x2d 0x1162 0xfa0 0x00 0x00 0x00 0x00 0x37 0x1004 0x9c4 0x00 0x00 0x00 0x00>;
		temp_t4_thres_minus_x_degree = <0x2f>;
		min_charge_temp_plus_x_degree = <0x05>;
		usb_charger_current = <0x7a120>;
		enable-vbat-mon = <0x00>;
		jeita_temp_t2_to_t3_cv = <0x423920>;
		min_charger_voltage = <0x4630c0>;
		name = "charger";
		jeita_temp_t1_to_t2_cv = <0x40b280>;
		jeita_temp_below_t0_cv = <0x3da540>;
		max_pwr = <0x12>;
		gauge = <0x1c3>;
		cs,chrg-ffc-zones = <0x00 0x1162 0x96 0x0f 0x1162 0x96 0x19 0x1180 0x320 0x23 0x1180 0x320 0x28 0x1180 0x320 0x2d 0x1180 0x352 0x37 0x1004 0x96>;
		temp_t0_thres_plus_x_degree = <0x00>;
	};

	drm_wv: drm-wv {
		compatible = "mediatek,drm_wv";
		status = "okay";
		phandle = <0xe3>;
		name = "drm-wv";
	};

	pe45: pe45 {
		dcs-chg1-charger-current = <0x16e360>;
		low-temp-to-enter-pe45 = <0x10>;
		high-temp-to-leave-pe45 = <0x2e>;
		dual-polling-ieoc = <0x6ddd0>;
		pe45-r-cable-current-limit = <0xbb8 0xbb8 0xbb8 0x9c4 0x898>;
		min-charger-voltage = <0x4630c0>;
		pe45-r-cable-level = <0xc8 0x12c 0x190 0x1f4 0x1f4>;
		pe45-r-cable-voltage = <0x1388 0x157c 0x1770 0x1964 0x1b58>;
		low-temp-to-leave-pe45 = <0x0a>;
		vbat-threshold = <0x1036>;
		sc-input-current = <0x30d400>;
		slave-mivr-diff = <0x186a0>;
		ibus-err = <0x0e>;
		pe45-r-cable-1a-lower = <0x1f4>;
		compatible = "mediatek,charger,pe45";
		pe45-r-cable-2a-lower = <0x15f>;
		high-temp-to-enter-pe45 = <0x27>;
		pe45-r-cable-3a-lower = <0xf0>;
		pe45-stop-battery-soc = <0x50>;
		phandle = <0x16e>;
		sc-charger-current = <0x2dc6c0>;
		dcs-chg2-charger-current = <0x16e360>;
		dcs-input-current = <0x30d400>;
		name = "pe45";
		gauge = <0x1c3>;
	};

	utos_tester {
		compatible = "microtrust,tester-v1";
		name = "utos_tester";
	};

	low_battery_throttling {
