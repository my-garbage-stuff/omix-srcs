			name = "pinctrl";
			interrupt-controller;

			cam2@2 {
				phandle = <0x1d0>;
				name = "cam2";

				pins_cmd_dat {
					pinmux = <0x1700>;
					slew-rate = <0x01>;
					name = "pins_cmd_dat";
					output-low;
				};
