			reg = <0x00 0x10005000 0x00 0x1000 0x00 0x11b10000 0x00 0x1000 0x00 0x11c40000 0x00 0x1000 0x00 0x11d10000 0x00 0x1000 0x00 0x11d30000 0x00 0x1000 0x00 0x11d40000 0x00 0x1000 0x00 0x11e30000 0x00 0x1000 0x00 0x11eb0000 0x00 0x1000 0x00 0x11ec0000 0x00 0x1000>;
			phandle = <0x20>;
			#gpio-cells = <0x02>;
