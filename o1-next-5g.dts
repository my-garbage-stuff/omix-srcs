				phandle = <0x1c9>;
				name = "cam0";

				pins_cmd_dat {
					output-high;
					pinmux = <0x1600>;
					slew-rate = <0x01>;
					name = "pins_cmd_dat";
				};
			};

			mmc0default {
				phandle = <0x1ac>;
				name = "mmc0default";

				pins_rst {
					drive-strength = <0x04>;
					pinmux = <0xb801>;
					bias-pull-up = <0x64>;
					name = "pins_rst";
				};

				pins_clk {
					drive-strength = <0x04>;
					pinmux = <0xb601>;
					bias-pull-down = <0x66>;
					name = "pins_clk";
