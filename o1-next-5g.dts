				phandle = <0xf7>;
				name = "aud_nle_mosi_on";

				pins_cmd1_dat {
					bias-disable;
					pinmux = <0xa601>;
					input-schmitt-enable;
					name = "pins_cmd1_dat";
				};

				pins_cmd2_dat {
					bias-disable;
					pinmux = <0xa701>;
					input-schmitt-enable;
					name = "pins_cmd2_dat";
				};
			};

			sel_high {
				phandle = <0x203>;
				name = "sel_high";

				pins_cmd_dat {
					output-high;
					pinmux = <0x3600>;
					name = "pins_cmd_dat";
				};
			};

