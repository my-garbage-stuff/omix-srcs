		max_charger_voltage = <0xb71b00>;
		temp_t3_thres = <0x2d>;
		max_charge_temp = <0x39>;
		io-channels = <0x19 0x02>;
		temp_t0_thres = <0x00>;
		enable_fast_charging_indicator;
		min_charger_voltage_2 = <0x401640>;
		temp_t1_thres_plus_x_degree = <0x06>;
