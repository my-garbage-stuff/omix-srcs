	cam3_inner_legacy@1a078000 {
		compatible = "mediatek,cam3_inner_legacy";
		reg = <0x00 0x1a078000 0x00 0x8000>;
	};

	fhctl: fhctl@1000ce00 {
		compatible = "mediatek,mt6853-fhctl";
		reg = <0x00 0x1000ce00 0x00 0x200 0x00 0x1000c000 0x00 0xe00>;
		phandle = <0x92>;

		map0 {
			method = "fhctl-mcupm";
			domain = "top";

			armpll_bl2 {
				perms = <0x1c>;
				pll-id = <0x3e7>;
				fh-id = <0x03>;
			};

			armpll_bl0 {
				perms = <0x1c>;
				pll-id = <0x3e7>;
				fh-id = <0x01>;
			};

			mfgpll {
				pll-id = <0x09>;
				fh-id = <0x06>;
			};

			msdcpll {
				pll-id = <0x06>;
				fh-id = <0x0b>;
			};

			ccipll {
				perms = <0x1c>;
				pll-id = <0x3e7>;
				fh-id = <0x05>;
			};

			mainpll {
				pll-id = <0x04>;
				fh-id = <0x0a>;
			};

			tvdpll {
				pll-id = <0x0a>;
				fh-id = <0x0e>;
			};

			armpll_bl1 {
				perms = <0x1c>;
				pll-id = <0x3e7>;
				fh-id = <0x02>;
			};

			npupll {
				pll-id = <0x08>;
				fh-id = <0x04>;
			};

			mpll {
				perms = <0x1c>;
				pll-id = <0x3e7>;
				fh-id = <0x08>;
			};

			armpll_ll {
				perms = <0x1c>;
				pll-id = <0x3e7>;
