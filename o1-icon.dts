	utos_tester {
		compatible = "microtrust,tester-v1";
	};

	low_battery_throttling {
		temperature-stage-threshold = <0x19 0x0a 0x00>;
		thd-volts-l = <0xcb2 0xc1c 0xb54 0xcb2 0xc1c 0xb54 0xcb2 0xc1c 0xb54 0xcb2 0xc1c 0xb54>;
		thd-volts-h = <0xd48 0xcb2 0xc1c 0xd48 0xcb2 0xc1c 0xd48 0xcb2 0xc1c 0xd48 0xcb2 0xc1c>;
		vbat-thd-enable = <0x01>;
		compatible = "mediatek,low_battery_throttling";
