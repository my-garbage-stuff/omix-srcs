		};

		opp-1 {
			opp-microvolt = <0x927c0>;
			opp-hz = <0x00 0x1298be00>;
		};

		opp-2 {
			opp-microvolt = <0x9eb10>;
			opp-hz = <0x00 0x18cba800>;
		};

		opp-0 {
			opp-microvolt = <0x86470>;
			opp-hz = <0x00 0xda64340>;
		};
	};

