				interrupts = <0x89 0x04 0x89 0x00>;
				interrupt-parent = <0x4a>;
				compatible = "mediatek,mt6366";
				#interrupt-cells = <0x02>;
				phandle = <0xac>;
				interrupt-controller;

				mt6358codec: mt6358codec {
					nvmem-names = "pmic-hp-efuse";
					io-channels = <0x19 0x0c>;
					reg_vaud28-supply = <0x51>;
					mediatek,dmic-mode = <0x00>;
					compatible = "mediatek,mt6366-sound";
					nvmem = <0x4e>;
					phandle = <0x144>;
					mediatek,mic-type = <0x01>;
					io-channel-names = "pmic_hpofs_cal";
				};

				pmic_efuse: mt6358-efuse {
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					compatible = "mediatek,mt6358-efuse";
					phandle = <0x4e>;

					mt6366_thermal_efuse: mt6366_e_data {
						reg = <0x40 0x0c>;
						phandle = <0x1a>;
					};
				};

				mt6358_batoc_throttle: mtk_battery_oc_throttling {
					oc-thd = <0x1770 0x1b58 0x1f40>;
					compatible = "mediatek,mt6358-battery_oc_throttling";
					phandle = <0x147>;
				};

				mt6366keys: mt6366keys {
					power-off-time-sec = <0x00>;
					compatible = "mediatek,mt6366-keys";
					mediatek,long-press-mode = <0x01>;
					phandle = <0x11f>;

					power {
						linux,keycodes = <0x74>;
						wakeup-source;
					};

					home {
						linux,keycodes = <0x73>;
					};
				};

				mt6358_dynamic_loading_throttling: mtk_dynamic_loading_throttling {
					io-channels = <0x19 0x0f 0x19 0x10 0x19 0x00>;
					uvlo-level = <0xa28>;
					compatible = "mediatek,mt6358-dynamic_loading_throttling";
					bootmode = <0x50>;
					phandle = <0x142>;
					io-channel-names = "pmic_ptim", "pmic_imix_r", "pmic_batadc";
				};

				pmic_auxadc: mt635x-auxadc {
					nvmem-names = "auxadc_efuse_dev";
					#io-channel-cells = <0x01>;
					compatible = "mediatek,pmic-auxadc", "mediatek,mt6358-auxadc";
					nvmem = <0x4e>;
					phandle = <0x19>;
					cali-efuse-offset = <0x01>;

					dcxo_volt {
						channel = <0x0a>;
						resistance-ratio = <0x03 0x02>;
					};

					bat_temp {
						channel = <0x03>;
						resistance-ratio = <0x02 0x01>;
					};

					vbif {
						channel = <0x0e>;
						resistance-ratio = <0x02 0x01>;
					};

					chip_temp {
						channel = <0x05>;
					};

					imix_r {
						channel = <0x10>;
						val = <0x00>;
					};

					accdet {
						channel = <0x09>;
					};

					vcdt {
						channel = <0x02>;
					};

					vcore_temp {
						channel = <0x06>;
					};

					batadc {
						avg-num = <0x80>;
						channel = <0x00>;
						resistance-ratio = <0x03 0x01>;
					};

					vgpu_temp {
						channel = <0x08>;
					};

					vproc_temp {
						channel = <0x07>;
					};

					imp {
						avg-num = <0x80>;
						channel = <0x0f>;
						resistance-ratio = <0x03 0x01>;
					};

					dcxo_temp {
						avg-num = <0x10>;
						channel = <0x0d>;
					};

					hpofs_cal {
						avg-num = <0x100>;
						channel = <0x0c>;
					};

					tsx_temp {
						avg-num = <0x80>;
						channel = <0x0b>;
					};
				};

				mt6358rtc: mt6358rtc {
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					compatible = "mediatek,mt6358-rtc";
					skip-lpsd-solution;
					phandle = <0x145>;

					ext_32k: ext_32k {
						bits = <0x06 0x01>;
						reg = <0x02 0x01>;
						phandle = <0x146>;
